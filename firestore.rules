rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // UserTrips — only owner can read, create, update, or delete
    match /UserTrips/{tripId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // UserNotes — only owner can read and write
    match /UserNotes/{noteId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // UserProfiles — each user reads/writes only their own profile
    match /UserProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Price searches — Cloud Function writes; users read own history
    match /priceSearches/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; 
    }

    // User preferences — each user reads/writes only their own doc
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Agent jobs — users read their own jobs, Cloud Function writes
    match /agentJobs/{jobId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; 
    }

    // Itinerary cache — read-only for authenticated users, function writes
    match /itineraryCache/{docId} {
      allow read: if request.auth != null;
      allow write: if false; 
    }

    // Admins - Read-only for checking own status
    match /Admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; 
    }

    // Analytics — append-only by anyone, read by admins
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read: if request.auth != null && exists(/databases/$(database)/documents/Admins/$(request.auth.uid));
      allow update, delete: if false;
    }
  }
}